rules_version = '2';

// Security rules of Tavola's Firestore. They have to match how the app stores things: see
// data/src/main/kotlin/com/tavola/data/group/GroupDocuments.kt, which lists the shape of every document.
//
//   users/{userId}                    { groupId }                  the group of a person, or null
//   groups/{groupId}                  { name, memberIds, inviteCode, createdBy }
//   groups/{groupId}/members/{userId} { displayName, photoUrl, colorIndex, joinCode? }
//   groups/{groupId}/recipes/{recipeId} { title, prepTimeMinutes?, tags, ingredients, steps, createdBy? }
//   groups/{groupId}/meals/{date}_{type} { date, type, title, recipeId?, prepTimeMinutes?, tags, note?, createdBy? }
//   groups/{groupId}/tasks/{taskId}     { date, text, done, createdAt, createdBy? }
//   groups/{groupId}/shopping/{itemId}  { name, category, quantity?, checked, createdAt, addedBy? }
//   invites/{code}                    { groupId }                  lets a person who knows the code find the group
//
// The ideas, from the decisions in docs/PLAN.md:
// - Everything is closed by default: only what is matched below can be read or written, and only by a signed-in person.
// - A group, its members and (later) its calendar and recipes can only be read by the members of that group, who all have the
//   same permissions: nobody can remove another member, and a group is never deleted.
// - A person who is not a member yet finds a group by reading `invites/{code}` by its exact id (`get`, never a list), which only
//   holds the id of the group. To join, they write their own member document carrying the code and add themselves to the group
//   in the same transaction; the rules check that the code they carry is the current one of the group.
// - Renewing a code deletes the old invite and creates the new one in the same transaction, so the old code stops working.
//
// How to publish them: paste this file in the Firebase console (Firestore Database, Rules, Publish), or run
// `firebase deploy --only firestore:rules` with the Firebase CLI. The rules are not part of the app: a change here is live as soon
// as it is published, and the app has to be compatible with the rules that are live.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userId() {
      return request.auth.uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, memberId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(memberId);
    }

    function isMember(groupData) {
      return userId() in groupData.memberIds;
    }

    // A name of 1 to 40 characters (the app cuts it at 40 and removes line breaks).
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    // 8 characters of the alphabet without look-alikes (no 0, O, 1, I or L).
    function validCode(code) {
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{8}$');
    }

    // A recipe: a title, an optional time, and lists of tags, ingredients and steps, within sizes a person would never reach.
    // `createdBy` is who made it; it is only written when the recipe is created.
    function validRecipe(recipe) {
      return recipe.keys().hasOnly(['title', 'prepTimeMinutes', 'tags', 'ingredients', 'steps', 'createdBy'])
        && recipe.title is string && recipe.title.size() >= 1 && recipe.title.size() <= 120
        && (recipe.prepTimeMinutes == null || (recipe.prepTimeMinutes is int && recipe.prepTimeMinutes >= 0))
        && recipe.tags is list && recipe.tags.size() <= 30
        && recipe.ingredients is list && recipe.ingredients.size() <= 100
        && recipe.steps is list && recipe.steps.size() <= 100
        && (!('createdBy' in recipe.keys()) || recipe.createdBy is string);
    }

    // An ISO date such as 2026-10-21.
    function validDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A meal of a slot: its id is the day and the meal ("2026-10-21_Lunch"), so a slot never holds two meals. A recipe carries a
    // copy of its title, time and tags, so the calendar can be drawn without loading the recipes.
    function validMeal(mealId, meal) {
      return meal.keys().hasOnly(['date', 'type', 'title', 'recipeId', 'prepTimeMinutes', 'tags', 'note', 'createdBy'])
        && validDate(meal.date)
        && meal.type in ['Lunch', 'Dinner']
        && mealId == meal.date + '_' + meal.type
        && meal.title is string && meal.title.size() >= 1 && meal.title.size() <= 120
        && (!('recipeId' in meal.keys()) || meal.recipeId == null || meal.recipeId is string)
        && (!('prepTimeMinutes' in meal.keys()) || meal.prepTimeMinutes == null || (meal.prepTimeMinutes is int && meal.prepTimeMinutes >= 0))
        && (!('tags' in meal.keys()) || (meal.tags is list && meal.tags.size() <= 30))
        && (!('note' in meal.keys()) || meal.note == null || (meal.note is string && meal.note.size() <= 500))
        && (!('createdBy' in meal.keys()) || meal.createdBy is string);
    }

    // A task of a day: a text, whether it is done, and when it was created (which is what orders the tasks of a day).
    function validTask(task) {
      return task.keys().hasOnly(['date', 'text', 'done', 'createdAt', 'createdBy'])
        && validDate(task.date)
        && task.text is string && task.text.size() >= 1 && task.text.size() <= 200
        && task.done is bool
        && task.createdAt is int
        && (!('createdBy' in task.keys()) || task.createdBy is string);
    }

    // An item of the shopping list: a name, one of the fixed categories, an optional free-text quantity, whether it is ticked, and
    // when it was added by the server's clock (which orders the list). `addedBy` is who added it; it is only written when the item is created.
    function validShoppingItem(item) {
      return item.keys().hasOnly(['name', 'category', 'quantity', 'checked', 'createdAt', 'addedBy'])
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 120
        && item.category in ['FruitAndVegetables', 'MeatAndFish', 'DairyAndEggs', 'Pantry', 'Bakery', 'Frozen', 'Drinks', 'Household', 'Other']
        && (!('quantity' in item.keys()) || item.quantity == null || (item.quantity is string && item.quantity.size() <= 60))
        && item.checked is bool
        && item.createdAt is timestamp
        && (!('addedBy' in item.keys()) || item.addedBy is string);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // The invite of a group and the code the group says it has always go together: `invites/{code}` has to point to the group, in
    // the same transaction that gives the group that code. When a code is renewed the old invite has to be gone by the end of it.
    function inviteMatchesNewGroup(groupId, code) {
      return getAfter(invitePath(code)).data.groupId == groupId;
    }

    function inviteIsRenewed(groupId, oldCode, newCode) {
      return oldCode == newCode
        || (getAfter(invitePath(newCode)).data.groupId == groupId && !existsAfter(invitePath(oldCode)));
    }

    // The group of a person. Only they can read or write it, and it only ever holds the id of a group (or null).
    match /users/{uid} {
      allow read: if signedIn() && userId() == uid;
      allow create, update: if signedIn() && userId() == uid
        && request.resource.data.keys().hasOnly(['groupId'])
        && (request.resource.data.groupId == null || request.resource.data.groupId is string);
      allow delete: if false;
    }

    // Found by its exact id to join a group; never listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      // Created with a group (or when its code is renewed): the code has to be the current one of a group the person is in.
      allow create: if signedIn()
        && validCode(code)
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code
        && isMember(getAfter(groupPath(request.resource.data.groupId)).data);
      allow update: if false;

      // Deleted when its code is renewed, by a member of the group it points to.
      allow delete: if signedIn() && isMember(get(groupPath(resource.data.groupId)).data);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && isMember(resource.data);

      // A person creates a group with themselves as its only member.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'inviteCode', 'createdBy'])
        && request.resource.data.memberIds == [userId()]
        && request.resource.data.createdBy == userId()
        && validName(request.resource.data.name)
        && validCode(request.resource.data.inviteCode)
        && inviteMatchesNewGroup(groupId, request.resource.data.inviteCode);

      allow update: if signedIn() && (
        // A member renames the group or renews its code (changing nothing else). A new code needs its invite, and the old
        // invite has to be deleted in the same transaction, so a code that no one can use is never left in the group.
        (isMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'inviteCode'])
          && validName(request.resource.data.name)
          && validCode(request.resource.data.inviteCode)
          && inviteIsRenewed(groupId, resource.data.inviteCode, request.resource.data.inviteCode))
        // A member leaves: the only change is that they are no longer in the list. Nobody can remove someone else.
        || (isMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([userId()].toSet()))
        // Someone who is not a member joins: the only change is that they are added at the end of the list, and the member
        // document they write in the same transaction carries the current code of the group.
        || (!isMember(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([userId()])
          && getAfter(memberPath(groupId, userId())).data.joinCode == resource.data.inviteCode)
      );

      // A group is never deleted: when the last member leaves it stays, without members.
      allow delete: if false;

      // The recipe book of the group: every member reads, creates, edits and deletes recipes (all members have the same
      // permissions). Only the shape is checked, so a broken client cannot fill the database with arbitrary data.
      match /recipes/{recipeId} {
        allow read: if signedIn() && isMember(get(groupPath(groupId)).data);
        allow create, update: if signedIn() && isMember(get(groupPath(groupId)).data) && validRecipe(request.resource.data);
        allow delete: if signedIn() && isMember(get(groupPath(groupId)).data);
      }

      // The calendar of the group: the meals (one document per slot, with the id of the slot) and the tasks (one document each).
      // Every member reads and writes them; only the shape is checked.
      match /meals/{mealId} {
        allow read: if signedIn() && isMember(get(groupPath(groupId)).data);
        allow create, update: if signedIn() && isMember(get(groupPath(groupId)).data) && validMeal(mealId, request.resource.data);
        allow delete: if signedIn() && isMember(get(groupPath(groupId)).data);
      }

      match /tasks/{taskId} {
        allow read: if signedIn() && isMember(get(groupPath(groupId)).data);
        allow create, update: if signedIn() && isMember(get(groupPath(groupId)).data) && validTask(request.resource.data);
        allow delete: if signedIn() && isMember(get(groupPath(groupId)).data);
      }

      // The shopping list of the group: one document per item. Every member reads and writes it; only the shape is checked.
      match /shopping/{itemId} {
        allow read: if signedIn() && isMember(get(groupPath(groupId)).data);
        allow create, update: if signedIn() && isMember(get(groupPath(groupId)).data) && validShoppingItem(request.resource.data);
        allow delete: if signedIn() && isMember(get(groupPath(groupId)).data);
      }

      match /members/{memberId} {
        allow read: if signedIn() && isMember(get(groupPath(groupId)).data);

        // A person writes only their own member document, and only as part of becoming a member: the group has to list them
        // once the transaction is done. Whoever creates the group has no code; whoever joins carries the current one.
        allow create: if signedIn() && memberId == userId()
          && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'colorIndex', 'joinCode'])
          && request.resource.data.colorIndex is int
          && isMember(getAfter(groupPath(groupId)).data)
          && (!exists(groupPath(groupId))
            || request.resource.data.joinCode == get(groupPath(groupId)).data.inviteCode);
        allow update: if false;

        // A person can remove their own member document (they do it when they leave).
        allow delete: if signedIn() && memberId == userId();
      }
    }
  }
}
