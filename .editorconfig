root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Los composables se nombran con PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Tokens de color/forma como `val Azafran` (PascalCase) son intencionados.
ktlint_standard_property-naming = disabled
# Comas finales (diffs más limpios), como en el resto del código.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
